{
  "name": "@sdap/api",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify API: projects, runs, findings, policies, webhooks, auth.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "openapi": "tsx scripts/generate-openapi.ts && prettier --write openapi.json"
  },
  "dependencies": {
    "@sdap/core": "workspace:*",
    "@sdap/normalizer": "workspace:*",
    "bullmq": "^6.7.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "yaml": "^2.9.1"
  }
}
