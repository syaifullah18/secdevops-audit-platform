{
  "name": "@sdap/cli",
  "version": "0.0.0",
  "private": true,
  "description": "sdap CLI for CI pipelines: trigger runs, wait, and fail on policy.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@sdap/core": "workspace:*"
  }
}
