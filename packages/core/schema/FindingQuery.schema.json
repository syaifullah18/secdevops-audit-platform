{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "verdict": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["confirmed", "needs_validation", "rejected"]
      }
    },
    "status": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["new", "confirmed", "in_progress", "fixed", "accepted_risk", "false_positive"]
      }
    },
    "minSeverity": {
      "type": "string",
      "enum": ["informational", "low", "medium", "high", "critical"]
    },
    "attackClass": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z0-9][a-z0-9_.:/-]*$"
      }
    },
    "includeRejected": {
      "default": false,
      "type": "boolean"
    },
    "q": {
      "type": "string",
      "maxLength": 200
    },
    "cursor": {
      "type": "string"
    },
    "limit": {
      "default": 50,
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    }
  }
}
