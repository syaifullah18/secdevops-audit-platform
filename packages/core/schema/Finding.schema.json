{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "projectId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "fingerprint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"
    },
    "sourceRun": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "firstRun": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "attackClass": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9_.:/-]*$"
    },
    "cwe": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^CWE-\\d{1,5}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "rootCause": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "location": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "endLine": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "symbol": {
          "type": "string"
        }
      },
      "required": ["file", "line"]
    },
    "trace": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["entrypoint", "propagation", "sink"]
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["kind", "file", "line", "scope", "description"]
      }
    },
    "evidence": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["file", "line", "description"]
      }
    },
    "verdict": {
      "type": "string",
      "enum": ["confirmed", "needs_validation", "rejected"]
    },
    "originalSeverity": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["informational", "low", "medium", "high", "critical"]
        },
        {
          "type": "null"
        }
      ]
    },
    "verifiedSeverity": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["informational", "low", "medium", "high", "critical"]
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": ["new", "confirmed", "in_progress", "fixed", "accepted_risk", "false_positive"]
    },
    "owner": {
      "type": ["string", "null"]
    },
    "firstSeen": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "lastSeen": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "slaDue": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        }
      },
      "required": ["adapter", "model"]
    },
    "phase": {
      "type": "string",
      "enum": [
        "preflight",
        "recon",
        "hunt",
        "triage",
        "validate",
        "output",
        "record_verify",
        "report"
      ]
    },
    "blockers": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rejectionReason": {
      "type": ["string", "null"]
    },
    "remediation": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "strategy": {
              "type": "string",
              "minLength": 1
            },
            "codeChanges": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "fixedCode": {
                    "type": "string"
                  }
                },
                "required": ["file", "fixedCode"]
              }
            }
          },
          "required": ["strategy"]
        },
        {
          "type": "null"
        }
      ]
    },
    "triageSuggestion": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "severityBand": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "enum": ["informational", "low", "medium", "high", "critical"]
              },
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "required": ["informational", "low", "medium", "high", "critical"]
            },
            "ownerCandidates": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "owner": {
                    "type": "string"
                  },
                  "probability": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": ["owner", "probability"]
              }
            },
            "duplicateOf": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "fingerprint": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"
                  },
                  "probability": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": ["fingerprint", "probability"]
              }
            },
            "falsePositiveProbability": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "model": {
              "type": "object",
              "properties": {
                "adapter": {
                  "type": "string",
                  "minLength": 1
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string"
                }
              },
              "required": ["adapter", "model"]
            }
          },
          "required": ["model"]
        },
        {
          "type": "null"
        }
      ]
    },
    "rootCauseGroup": {
      "type": ["string", "null"]
    }
  },
  "required": [
    "id",
    "projectId",
    "fingerprint",
    "sourceRun",
    "firstRun",
    "attackClass",
    "cwe",
    "title",
    "description",
    "rootCause",
    "location",
    "trace",
    "evidence",
    "verdict",
    "originalSeverity",
    "verifiedSeverity",
    "confidence",
    "status",
    "owner",
    "firstSeen",
    "lastSeen",
    "slaDue",
    "model",
    "phase",
    "rejectionReason",
    "remediation",
    "triageSuggestion",
    "rootCauseGroup"
  ]
}
