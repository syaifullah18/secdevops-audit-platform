{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "mode": {
      "default": "focused",
      "type": "string",
      "enum": ["focused", "incremental", "full"]
    },
    "repeat": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "ref": {
      "default": "HEAD",
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "default": {},
      "type": "object",
      "properties": {
        "paths": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "attackClasses": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9_.:/-]*$"
          }
        },
        "maxRuntimeSec": {
          "default": 14400,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "tokenBudget": {
          "default": null,
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "trigger": {
      "default": {
        "kind": "api",
        "ref": null
      },
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["manual", "api", "ci", "schedule", "release_tag", "webhook"]
        },
        "ref": {
          "default": null,
          "type": ["string", "null"]
        }
      },
      "required": ["kind"]
    }
  },
  "required": ["projectId"]
}
