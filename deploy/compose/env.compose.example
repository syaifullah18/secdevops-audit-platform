# Extra variables read by docker-compose.yml, on top of the repository's .env.example.
# Append what you want to change to your .env. Every value has an evaluation-only default in
# docker-compose.yml; the hardened override (docker-compose.hardened.yml) strictly requires
# POSTGRES_PASSWORD, GRAFANA_PG_PASSWORD, and GRAFANA_ADMIN_PASSWORD to be non-empty.
POSTGRES_USER=sdap
POSTGRES_PASSWORD=
POSTGRES_DB=sdap
# Password of the read-only PostgreSQL role used by Grafana.
GRAFANA_PG_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Host ports (always bound to 127.0.0.1).
WEB_HOST_PORT=3000
API_HOST_PORT=8080
GRAFANA_HOST_PORT=3001
PROMETHEUS_RETENTION=15d
WORKER_CONCURRENCY=2
# Container runtime socket for log shipping (Podman: output of `podman machine inspect`).
CONTAINER_SOCKET=/var/run/docker.sock
