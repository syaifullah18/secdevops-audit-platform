# Copy to .env and fill in. Never commit real values.
NODE_ENV=development
LOG_LEVEL=info

# Store and queue
DATABASE_URL=postgres://sdap:sdap@localhost:5432/sdap
REDIS_URL=redis://localhost:6379

# API
API_PORT=8080
API_BASE_URL=http://localhost:8080
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=
# Development only: accept static bearer tokens instead of OIDC.
AUTH_DEV_MODE=false

# Native accounts (sign-up, password, Google/GitHub). Off by default; see deploy/README.md.
AUTH_NATIVE=false
# `openssl rand -hex 32`; required when GOOGLE_* or GITHUB_* is set.
AUTH_SECRET=
# open | invite | closed. The first account (or BOOTSTRAP_ADMIN_EMAIL) becomes admin.
SIGNUP_MODE=invite
PASSWORD_LOGIN=true
BOOTSTRAP_ADMIN_EMAIL=
SIGNUP_DEFAULT_ROLE=viewer
SESSION_TTL_DAYS=14
# Public URL of the web app and of the API as browsers reach it (same host behind the nginx proxy).
WEB_BASE_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3000
# Set to true behind a reverse proxy so rate limits use the real client address.
TRUST_PROXY=false
# Mail for verification, reset and invitations, e.g. smtps://user:pass@smtp.example.com
SMTP_URL=
MAIL_FROM=
REQUIRE_EMAIL_VERIFICATION=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Object storage (MinIO or S3-compatible, self-hosted)
ARTIFACT_STORE_URL=
ARTIFACT_STORE_BUCKET=sdap-artifacts

# Model adapters (all optional; the mock adapter works without any key)
MODEL_DEFAULT_ADAPTER=mock
JEV_API_URL=
JEV_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
LOCAL_MODEL_BASE_URL=http://localhost:11434

# Telemetry is off unless the operator opts in.
SDAP_TELEMETRY=off
