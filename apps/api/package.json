{
  "name": "@sdap/api",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify API: projects, runs, findings, policies, webhooks, auth.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@sdap/core": "workspace:*",
    "@sdap/normalizer": "workspace:*"
  }
}
