# Copy to .env and fill in. Never commit real values.
NODE_ENV=development
LOG_LEVEL=info

# Store and queue
DATABASE_URL=postgres://sdap:sdap@localhost:5432/sdap
REDIS_URL=redis://localhost:6379

# API
API_PORT=8080
API_BASE_URL=http://localhost:8080
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=
# Development only: accept static bearer tokens instead of OIDC.
AUTH_DEV_MODE=false

# Object storage (MinIO or S3-compatible, self-hosted)
ARTIFACT_STORE_URL=
ARTIFACT_STORE_BUCKET=sdap-artifacts

# Model adapters (all optional; the mock adapter works without any key)
MODEL_DEFAULT_ADAPTER=mock
JEV_API_URL=
JEV_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
LOCAL_MODEL_BASE_URL=http://localhost:11434

# Telemetry is off unless the operator opts in.
SDAP_TELEMETRY=off
