      "is_read_only": false
    }
  ],
  "machine_config": {
    "vcpu_count": 2,
    "mem_size_mib": 4096,
    "smt": false
  },
  "network_interfaces": [
    {
      "iface_id": "eth0",
      "guest_mac": "AA:FC:00:00:00:01",
      "host_dev_name": "tap-sdap-0",
      "egress_proxy_only": true
    }
  ],
  "jailer": {
    "id": "sdap-vm-stub",
    "exec_file": "/usr/bin/firecracker",
    "uid": 65534,
    "gid": 65534,
    "chroot_base_dir": "/srv/jailer",
    "cgroup_version": 2
  }
