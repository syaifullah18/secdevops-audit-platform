{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FirecrackerMicroVmProfileStub",
  "description": "Configuration profile stub for Phase 2 Firecracker microVM sandboxing",
  "version": "0.1.0-stub",
  "status": "deferred-phase-2",
  "boot_source": {
    "kernel_image_path": "/opt/sdap/kernels/vmlinux-6.1",
    "boot_args": "console=ttyS0 reboot=k panic=1 pci=off init=/init root=/dev/vda ro"
  },
  "drives": [
    {
      "drive_id": "rootfs",
      "path_on_host": "/opt/sdap/images/rootfs-alpine-base.ext4",
